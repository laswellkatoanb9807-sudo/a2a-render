+// normalizeGenerateRequestLineEndings 把生成请求的文本换行归一化为 LF，必须在编码请求体之前调用
+func normalizeGenerateRequestLineEndings(request *GenerateRequest) {
+	if request == nil {
+		return
+	}
+	for index := range request.System {
+		request.System[index] = normalizePromptLineEndings(request.System[index])
+	}
+	for index := range request.Contents {
+		for part := range request.Contents[index].Parts {
+			request.Contents[index].Parts[part].Text = normalizePromptLineEndings(request.Contents[index].Parts[part].Text)
+		}
+	}
+}
