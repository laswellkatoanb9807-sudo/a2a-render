@@ -0,0 +1,45 @@
+package aistudio
+
+import "testing"
+
+// TestNormalizePromptLineEndings 验证 CRLF/CR 统一成 LF，且对纯 LF 文本幂等
+func TestNormalizePromptLineEndings(t *testing.T) {
+	for _, test := range []struct{ name, value, want string }{
+		{"lf", "a\nb", "a\nb"},
+		{"crlf", "a\r\nb", "a\nb"},
+		{"cr", "a\rb", "a\nb"},
+		{"mixed", "a\r\nb\nc\rd", "a\nb\nc\nd"},
+		{"empty", "", ""},
+		{"no newline", "abc", "abc"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			if got := normalizePromptLineEndings(test.value); got != test.want {
+				t.Fatalf("normalizePromptLineEndings(%q) = %q, want %q", test.value, got, test.want)
+			}
+		})
+	}
+}
+
+// TestNormalizeGenerateRequestLineEndings 验证系统指令与各 Part 文本都被归一化，其余字段不动且幂等
+func TestNormalizeGenerateRequestLineEndings(t *testing.T) {
+	request := GenerateRequest{
+		System:   []string{"规则一\r\n规则二"},
+		Contents: []Content{{Role: RoleUser, Parts: []Part{{Text: "第一行\r\n第二行"}, {Text: "无换行"}}}},
+	}
+	normalizeGenerateRequestLineEndings(&request)
+	if request.System[0] != "规则一\n规则二" {
+		t.Fatalf("system not normalized: %q", request.System[0])
+	}
+	if request.Contents[0].Parts[0].Text != "第一行\n第二行" {
+		t.Fatalf("part text not normalized: %q", request.Contents[0].Parts[0].Text)
+	}
+	if request.Contents[0].Parts[1].Text != "无换行" {
+		t.Fatalf("plain text changed: %q", request.Contents[0].Parts[1].Text)
+	}
+	normalizeGenerateRequestLineEndings(&request)
+	if request.System[0] != "规则一\n规则二" || request.Contents[0].Parts[0].Text != "第一行\n第二行" {
+		t.Fatal("normalization is not idempotent")
+	}
+	// nil 请求不得 panic
+	normalizeGenerateRequestLineEndings(nil)
+}
