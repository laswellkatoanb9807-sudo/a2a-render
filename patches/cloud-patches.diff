+// normalizePromptLineEndings 把提示词换行归一化为 LF，保证 digest、写入与回读三方一致。
+// 官网 textarea 按 Firefox 规则把 CRLF 与 CR 归一为 LF；含 \r 的文本与回读值永远对不上。
+func normalizePromptLineEndings(prompt string) string {
+	if !strings.Contains(prompt, "\r") {
+		return prompt
+	}
+	prompt = strings.ReplaceAll(prompt, "\r\n", "\n")
+	return strings.ReplaceAll(prompt, "\r", "\n")
+}
